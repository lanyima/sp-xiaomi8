"""吉利车辆控制器。"""
from opendbc.can.packer import CANPacker
from opendbc.car import Bus, DT_CTRL, rate_limit, structs
from opendbc.car.lateral import apply_driver_steer_torque_limits  # xiaomi8: upstream moved this to lateral.py
from opendbc.car.interfaces import CarControllerBase
from opendbc.car.geely.geelycan import create_can_steer_command, create_acc_command
from opendbc.car.geely.values import CarControllerParams
from opendbc.sunnypilot.car.geely.mads import MadsCarController


class CarControllerConstants:
  """控制器常量定义。"""
  # 加速度速率限制 (参考Toyota, 放宽6倍避免顿挫)
  ACCEL_WINDUP_LIMIT = 4.0 * DT_CTRL * 3    # 加速时限制: 0.24 m/s² per frame
  ACCEL_WINDDOWN_LIMIT = -4.0 * DT_CTRL * 3  # 减速时限制: -0.24 m/s² per frame


class CarController(CarControllerBase, MadsCarController):
  """吉利车辆控制器，支持转向和纵向控制。"""

  def __init__(self, dbc_names, CP, CP_SP=None):
    CarControllerBase.__init__(self, dbc_names, CP, CP_SP)
    MadsCarController.__init__(self)
    self.params = CarControllerParams(CP)
    self.packer = CANPacker(dbc_names[Bus.pt])

    # 转向控制状态
    self.apply_torque_last = 0
    self.counter = 0
    self.last_steer_frame = 0
    self.last_acc_frame = 0

    # Anti-Nag: 防止"手离方向盘"警告 (参考大众VW实现)
    # 吉利摄像头通过监测转向角变化来检测手是否在方向盘上
    # 原车警告机制: 30秒警告 → 60秒严重警告 → 退出控制
    # 当转向命令保持相同超过一定时间，微调扭矩值以产生角度变化
    self.steer_same_torque_frame = 0
    self.STEER_TIME_STUCK_TORQUE = 10.0  # 秒，30秒警告前触发3次

    # 纵向控制状态
    self.last_accel = 0.0
    # 原厂 ACC 的静止恢复握手仅在原厂明确提出时短暂透传。
    # _handle_longitudinal_control 每 20 ms 运行，50 tick = 1 秒。
    self.factory_resume_ticks = 0

    # 原厂转向恢复状态
    self.last_steer_disable_time = 0.0
    self.prev_steer_enabled = False

  # 驾驶员干预检查由Safety层(Panda)自动处理:
  # - Safety层会检查gas_pressed_prev，自动阻止纵向控制
  # - 横向控制通过CC.latActive/longActive状态管理
  # - 参考Honda/Toyota/GM实现，carcontroller不需要单独检查驾驶员干预

  def _handle_longitudinal_control(self, CC, CS, can_sends):
    """处理纵向控制逻辑。

    参数:
      CC: CarControl对象
      CS: CarState对象
      can_sends: CAN消息列表
    """
    # 纵向控制状态判断：
    # - long_active=True: OP 真正控纵向 → 发自算加速度
    # - gas_override=True: 踩油门覆盖中(框架 gasPressed→gasPressedOverride→longActive=False,
    #   但 CC.enabled 仍True/ACC没退出) → 仍发OP自己的ACC_CMD, 只是accel强制0/不刹车,
    #   不透传原车摄像头当时的实时值(2026-08-26改: 之前这里透传cam_msg, 但原车摄像头此刻的
    #   CMD字段是它自己独立算出来的瞬时值——踩油门那一刻如果它正好在算减速, 透传等于一边
    #   给油一边发刹车指令给车, 疑似这个冲突触发过原车故障。参考同仓库toyota/honda/gm/vw/
    #   hyundai_canfd, 没有一家在override时透传外部单元的实时值, 全部是"永远发自己的消息,
    #   override时accel=0/不刹车", 改成一致做法。)
    # - 两者都不是(ACC本身没开/CC.enabled=False): 透传原车ACC_CMD, 维持消息连续性——这个
    #   场景OP完全没有意图, 让原车摄像头数据流过去没有冲突风险.
    long_active = self.CP.openpilotLongitudinalControl and CC.longActive
    # `longActive` is also cleared on a physical brake press.  Treating every
    # enabled-but-inactive cycle as a gas override made the brake-disengage
    # edge send ACC_REQ=0 for one controller tick: the factory cluster then
    # flashed ACC red even though its own brake handling immediately restored
    # the state. Only a real accelerator press is an OP longitudinal override.
    gas_override = (self.CP.openpilotLongitudinalControl and CC.enabled and
                    not CC.longActive and CS.out.gasPressed)

    if long_active or gas_override:
      # 控车时：计算加速度命令
      accel = CC.actuators.accel

      # 踩油门override时强制accel=0(不依赖CS.out.gasPressed这一帧是否恰好为True——
      # gas_override本身已经是"OP没有真正控纵向"的判据)
      if gas_override or CS.out.gasPressed:
        accel = 0.0  # 停止发送加速度命令，让用户自由控制

      # 跟车距离由 OP personality 系统控制 (selfdrived.py)
      # 按原车距离按钮会触发 gapAdjustCruise 事件，自动切换 personality

      # 速率限制加速度变化 (参考Toyota的generous rate limit，避免顿挫)
      accel = rate_limit(accel, self.last_accel,
                        CarControllerConstants.ACCEL_WINDDOWN_LIMIT,
                        CarControllerConstants.ACCEL_WINDUP_LIMIT)
      self.last_accel = accel
    else:
      # ACC本身没开：发送零值 (参考Honda L236-238)
      accel = 0.0

    # 纵向控制消息发送逻辑（和SP一致）：
    # - 只要开启了纵向控制，就始终发送ACC_CMD(保持消息连续性)
    # - long_active=True: 改写加速度等字段, 交给原车ACC自己的加减速回路执行(和人开车用原厂ACC同一条路径)
    # - gas_override=True: 也发OP自己的字段, 但accel已强制0(见上), 不透传原车摄像头实时值
    # - 都不是(ACC没开): 透传原车摄像头ACC_CMD
    # 注: 之前这里还并行发过GAS_COMMAND(0x200)/TORQUE_COMMAND(0x202)拦截器命令,
    #     实车CAN抓包(6份日志/合计约3000万帧, 含ACC_CMD/BRAKE等高频原生信号)里
    #     0x200/0x202从未出现过一次 —— 车上没有对应硬件, 那两条是死信号, 而且
    #     跟这里的ACC_CMD同时改车速会两套系统抢刹车/油门, 已删除.
    should_send_acc = self.CP.openpilotLongitudinalControl

    # 2026-08-28: 是否处于"驾驶员用油门覆盖纵向"的状态——不止gas_override(基于longActive),
    # CS.out.gasPressed单独也算(跟上面"if gas_override or CS.out.gasPressed: accel=0.0"
    # 用的是同一个判据), 传给create_acc_command好让ACC_REQ也跟着一起撤回。
    is_override = gas_override or CS.out.gasPressed

    # 原厂 ACC 在静止跟车恢复时会给出 RISING_ENGAGE；该时段透传原厂
    # 完整 ACC 帧，避免 OP 合成帧覆盖其起步握手。绝不自行伪造该信号。
    factory_rising = bool(CS.cam_acc_msg.get("RISING_ENGAGE", False))
    if long_active and not is_override and CS.out.standstill and factory_rising:
      self.factory_resume_ticks = 50
    if not long_active or is_override or not CS.out.standstill:
      self.factory_resume_ticks = 0
    factory_resume = self.factory_resume_ticks > 0
    if factory_resume:
      self.factory_resume_ticks -= 1

    if should_send_acc:
      can_sends.append(create_acc_command(
        self.packer,
        accel,                           # long_active/gas_override时是计算值(override已强制0)
        (long_active or gas_override) and not factory_resume,
                                         # 起步握手窗口仅透传原始帧
        CS.cam_acc_msg,                  # 原车摄像头数据(ACC未开/恢复握手时用作透传源)
        self.counter,                    # 计数器
        CS.out.standstill,               # 车辆静止标志
        is_override                      # 驾驶员油门覆盖中: ACC_REQ也要归0(实测原厂行为)
      ))

  def update(self, CC, CC_SP, CS, now_nanos):  # xiaomi8: upstream added CC_SP
    """生成车辆控制的CAN消息。

    参数:
      CC: 包含执行器命令的CarControl消息
      CS: 包含当前车辆状态的CarState
      now_nanos: 当前时间戳(纳秒)

    返回:
      tuple: (new_actuators, can_sends) - 更新后的执行器和CAN消息
    """
    # 更新MADS状态(HUD图标用, 当前未接入HUD消息)
    MadsCarController.update(self, self.CP, CC, CC_SP, self.frame)

    can_sends = []
    actuators = CC.actuators

    # === 转向控制 ===
    # 横向控制激活状态
    # 驾驶员扭矩过大不退出控制，允许大幅度转动
    steer_enabled = CC.latActive
    new_steer = int(round(actuators.torque * self.params.STEER_MAX))

    # 打灯变道处理：移除转向力度降低
    # 注意：之前设置为0.1会导致变道时方向盘几乎不转动，车辆冲出车道
    # 现在保持正常转向力度，让车辆能够正常变道
    # blinker_on = CS.out.leftBlinker or CS.out.rightBlinker
    # if blinker_on and steer_enabled:
    #   new_steer = int(new_steer * 0.1)

    # 驾驶员扭矩限制
    apply_steer = apply_driver_steer_torque_limits(new_steer, self.apply_torque_last,
                                                    CS.out.steeringTorque, self.params)

    # Anti-Nag: 防止"手离方向盘"警告 (参考大众VW实现)
    # 吉利摄像头通过监测转向角变化来检测手是否在方向盘上
    # 当转向命令保持相同超过1.9秒，微调扭矩值±1以产生微小角度变化
    if steer_enabled:
      if self.apply_torque_last == apply_steer:
        self.steer_same_torque_frame += self.params.STEER_STEP
        if self.steer_same_torque_frame > self.STEER_TIME_STUCK_TORQUE / DT_CTRL:
          # 微调扭矩值，方向与当前扭矩相反（如果扭矩为0则加1）
          if apply_steer != 0:
            apply_steer -= (1, -1)[apply_steer < 0]
          else:
            apply_steer = 1  # 扭矩为0时加1
          self.steer_same_torque_frame = 0
      else:
        self.steer_same_torque_frame = 0
    else:
      self.steer_same_torque_frame = 0

    # 原厂转向渐变恢复
    import time
    if not steer_enabled and self.prev_steer_enabled:
      self.last_steer_disable_time = time.monotonic()
    self.prev_steer_enabled = steer_enabled

    # 渐变恢复原厂控制
    if not steer_enabled and hasattr(CS, 'cam_lkas_msg'):
      stock_steer_cmd = CS.cam_lkas_msg.get('STEER_CMD', 0)
      if stock_steer_cmd > 0:
        elapsed = time.monotonic() - self.last_steer_disable_time
        mul = max(0.0, min(1.0, (elapsed - 0.55) / 0.5))
        steer_dir = CS.cam_lkas_msg.get('STEER_DIR', 0)
        apply_steer = int(stock_steer_cmd * (-1 if steer_dir else 1) * mul)
        apply_steer = apply_steer & ~1

    # 发送转向命令 - 50Hz
    if (self.frame - self.last_steer_frame) >= self.params.STEER_STEP:
      self.counter = (self.counter + 1) % 16

      can_sends.append(create_can_steer_command(
        self.packer,
        apply_steer,
        steer_enabled,
        CS.cam_lkas_msg,
        self.counter
      ))

      self.last_steer_frame = self.frame

    # === 纵向控制 ===
    if (self.frame - self.last_acc_frame) >= self.params.STEER_STEP:
      self._handle_longitudinal_control(CC, CS, can_sends)
      self.last_acc_frame = self.frame

    # === 更新状态 ===
    self.frame += 1
    self.apply_torque_last = apply_steer

    # === 创建反馈执行器 ===
    new_actuators = structs.CarControl.Actuators()
    new_actuators.torque = apply_steer / self.params.STEER_MAX
    new_actuators.torqueOutputCan = float(apply_steer)

    return new_actuators, can_sends
