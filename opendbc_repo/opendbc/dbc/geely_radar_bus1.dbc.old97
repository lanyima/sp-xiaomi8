BS_:

BU_: RADAR XXX

VAL_TABLE_ TargetValid 0 "Invalid" 128 "Valid" ;

CM_ "Geely Continental ARS410 (ARS4-B) Radar - Bus 1";
CM_ "Hardware: Continental ARS410, 76-77GHz FMCW, 2TX+3RX antenna (6-channel DBF)";
CM_ "Official range: Short 55m (+/-45deg) / Mid 120m (+/-9deg) / Long 177m (+/-4deg)";
CM_ "Official velocity: -400~+200 km/h, accuracy +/-0.1 km/h, max 64 targets @ 15Hz";
CM_ "";
CM_ "DBC Parameters (VERIFIED with 26000+ real CAN messages - 2026-01-06):";
CM_ "  CORRECTED FORMAT (static target vRel error < 2 km/h):";
CM_ "  Byte 0-1: DISTANCE (Little-endian, unsigned, scale=0.0027) [0.2-177m]";
CM_ "  Byte 2:   VALID_LEVEL (0-255, quality indicator)";
CM_ "  Byte 3-4: RESERVED (NOT velocity! Previously misidentified)";
CM_ "  Byte 4:   REL_VELOCITY (unsigned, offset=128, scale=0.5) [+/-64 m/s = +/-230 km/h]";
CM_ "  Byte 6:   SIGNAL_QUALITY (unsigned, 0-255, higher=better)";
CM_ "  Byte 7:   AZIMUTH (unsigned, offset=128, scale=0.25) [+/-32 deg]";
CM_ "";
CM_ "  Key corrections (2026-01-06):";
CM_ "  - REL_VELOCITY: byte4 (offset 128, scale 0.5 m/s) - 2026-01-07 verified";
CM_ "    * Static target B4 mean=127.3 (vRel=0) verified with 45000+ samples";
CM_ "  - AZIMUTH: byte7 (offset 128, scale 0.25 deg) - 2026-01-07 verified";
CM_ "    * Valid target B7 mean=-0.18 deg (front=0) verified with 45000+ samples";
CM_ "  Target addresses: 0x20-0x80 (97 target slots)";


